{
  "name": "@dash/vod",
  "private": true,
  "type": "module",
  "exports": {
    "./db": {
      "types": "./db/index.ts",
      "import": "./db/index.ts"
    },
    "./db/*": {
      "types": "./db/*.ts",
      "import": "./db/*.ts"
    },
    "./schema": {
      "types": "./lib/schema.ts",
      "import": "./lib/schema.ts"
    },
    "./util": {
      "types": "./lib/util.ts",
      "import": "./lib/util.ts"
    }
  },
  "bin": {
    "video.sh": "./video.sh",
    "video.ts": "./videots_wrapper.sh",
